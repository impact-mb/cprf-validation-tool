# CPRF Validation Tool v2026.01
# Copy these values into Streamlit Cloud -> App settings -> Secrets.
# Do NOT commit a real secrets.toml file to GitHub.

APP_USERNAME = "impact_user"

# Generate this locally by running:
#     python generate_password_hash.py
# Store ONLY the generated hash here, never the original password.
APP_PASSWORD_HASH = "pbkdf2_sha256$600000$REPLACE_WITH_GENERATED_SALT$REPLACE_WITH_GENERATED_DIGEST"

# Existing optional GitHub usage counter configuration
GITHUB_OWNER = "your-github-owner"
GITHUB_REPO = "cprf-validation-tool"
GITHUB_TOKEN = "your-github-personal-access-token"
COUNTER_FILE_PATH = "usage_counter.txt"
